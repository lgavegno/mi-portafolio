# ═══════════════════════════════════════════════════════════════════════════
# .env.example — Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# IMPORTANTE:
#   1. Nunca commitear .env ni valores reales a Git
#   2. Copiar este archivo a .env.local en desarrollo
#   3. En Vercel: agregar variables en Settings > Environment Variables
#   4. Valores de ejemplo (demo): NO válidos para producción
#
# ═══════════════════════════════════════════════════════════════════════════

## ─────────────────────────────────────────────────────────────────────────
## EmailJS Configuration (Contact Form)
## ─────────────────────────────────────────────────────────────────────────
# Docs: https://www.emailjs.com/docs/
#
# Pasos para obtener credenciales:
#   1. Crear cuenta gratuita en https://www.emailjs.com/
#   2. Dashboard > Services > Add Service (ej: Gmail, Outlook)
#   3. Dashboard > Email Templates > Create Template
#      con variables: {{from_name}}, {{from_email}}, {{message}}
#   4. Dashboard > Account > API Keys > copy PUBLIC KEY
#   5. Completar variables abajo
#
# Límites de plan gratuito:
#   - 200 emails/mes
#   - Soporte limitado
#   - Rate: 1 email/segundo

VITE_EMAILJS_SERVICE_ID=service_your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=template_your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here_copy_from_dashboard

# Ejemplo válido (demo, reemplazar con valores reales):
# VITE_EMAILJS_SERVICE_ID=service_abc123
# VITE_EMAILJS_TEMPLATE_ID=template_xyz789
# VITE_EMAILJS_PUBLIC_KEY=public_key_qwerty

## ─────────────────────────────────────────────────────────────────────────
## Vercel Analytics (Opcional)
## ─────────────────────────────────────────────────────────────────────────
# Si se requiere tracking detallado en Vercel
# Nota: Vercel Analytics se activa automáticamente en Vercel, no requiere env vars

# VERCEL_ANALYTICS_ID=...

## ─────────────────────────────────────────────────────────────────────────
## Development / Build Configuration
## ─────────────────────────────────────────────────────────────────────────

# NODE_ENV (automático, no requiere configuración)
# Valores: development | production | test
# NODE_ENV=development

## ─────────────────────────────────────────────────────────────────────────
## Future / Reserved (para expansiones)
## ─────────────────────────────────────────────────────────────────────────

# Si se agrega CMS en futuro:
# VITE_CMS_API_URL=https://api.contentful.com/...
# VITE_CMS_ACCESS_TOKEN=...

# Si se agrega analytics/tracking:
# VITE_GOOGLE_ANALYTICS_ID=G-...
# VITE_HOTJAR_ID=...

# Si se agrega payment processing:
# VITE_STRIPE_PUBLIC_KEY=pk_...

## ═════════════════════════════════════════════════════════════════════════
## INSTRUCCIONES DE SETUP LOCAL
## ═════════════════════════════════════════════════════════════════════════
#
# 1. Crear archivo .env.local (no commitear):
#    cp .env.example .env.local
#
# 2. Abrir https://www.emailjs.com/ y crear cuenta
#
# 3. Obtener credenciales desde Dashboard:
#    - Settings > API Keys > copy "Public Key"
#    - Services > elige servicio > copy "Service ID"
#    - Email Templates > elige template > copy "Template ID"
#
# 4. Reemplazar valores en .env.local:
#    VITE_EMAILJS_PUBLIC_KEY=public_key_real_aqui
#    etc.
#
# 5. Verificar: npm run dev → Contact form debe funcionar
#
# 6. En Vercel:
#    - Dashboard > Proyecto > Settings > Environment Variables
#    - Agregar VITE_EMAILJS_* variables
#    - Redeploy
#
## ═════════════════════════════════════════════════════════════════════════
